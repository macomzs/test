{
  "name": "ecommerce-hub",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @app/web --filter @app/worker dev",
    "build": "pnpm --filter @app/web build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @app/db generate",
    "db:migrate": "pnpm --filter @app/db migrate",
    "db:seed": "pnpm --filter @app/db seed",
    "db:setup": "pnpm db:migrate && pnpm db:seed",
    "keys:generate": "node -e \"console.log(require('crypto').randomBytes(32).toString('base64'))\"",
    "start": "pnpm --parallel --filter @app/web --filter @app/worker start"
  }
}
