{
  "name": "E-commerce Hub",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "forwardPorts": [
    3000
  ],
  "portsAttributes": {
    "3000": {
      "label": "Panel E-commerce Hub",
      "onAutoForward": "openBrowser"
    },
    "5432": {
      "label": "PostgreSQL",
      "onAutoForward": "ignore"
    }
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md"
      ]
    },
    "vscode": {
      "extensions": [
        "bradlc.vscode-tailwindcss"
      ]
    }
  },
  "postAttachCommand": {
    "info": "echo 'Aby uruchomić aplikację, wpisz w terminalu: bash .devcontainer/start.sh'"
  }
}
