# Połączenie z bazą PostgreSQL
DATABASE_URL=postgres://app:app@localhost:5432/app

# Klucze szyfrujące sekrety marketplace (format: wersja:klucz_base64, kolejne po przecinku).
# Nowy klucz wygenerujesz poleceniem: pnpm keys:generate
APP_ENCRYPTION_KEYS=1:ZmFrZS1kZXYta2V5LWNoYW5nZS1tZS0zMi1ieXRlcyE=
APP_ENCRYPTION_ACTIVE_KEY=1

# Pierwsze konto administratora (tworzone przez pnpm db:seed, jeśli nie istnieje)
SEED_ADMIN_EMAIL=admin@firma.local
SEED_ADMIN_PASSWORD=ZmienToHaslo123!
